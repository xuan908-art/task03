<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =====通知权限写在这里！application标签外面===== -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Task03">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Exp1ListViewActivity"
            android:exported="false"
            android:label="实验1 ListView"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Task03.ActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Exp2DialogActivity"
            android:exported="false"
            android:label="实验2 自定义AlertDialog"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Task03.ActionBar" />
        <activity
            android:name=".Exp3MenuActivity"
            android:exported="false"
            android:label="MenuTest"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Task03.ActionBar" />
        <activity
            android:name=".Exp4ActionModeActivity"
            android:exported="false"
            android:label="实验4 ActionMode"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Task03.ActionBar" />
        <activity
            android:name=".Exp5RecyclerActivity"
            android:exported="false"
            android:label="实验5 RecyclerView"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Task03.ActionBar" />
    </application>

</manifest>